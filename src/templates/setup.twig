{% extends '_layouts/cp' %}
{% set title = 'Setup'|t('logging-library') %}
{% set selectedSubnavItem = 'setup' %}
{% set runtime = settings.runtimeConfig %}
{%
	set setupConfig = {
	    plugin: {
	        handle: 'logging-library',
	        name: settings.fullName,
	        version: pluginVersion,
	        iconSvg: pluginIconSvg,
	        heroStyle: pluginHeroStyle,
	        logoPaths: logoPaths,
	    },
	    page: {
	        badge: 'Setup'|t('logging-library'),
	        title: settings.fullName,
	        description: 'Choose the log views that suit this environment. Runtime capture is optional and remains off until enabled.'|t('logging-library'),
	    },
	    actions: {
	        primary: {label: 'Runtime Logs'|t('logging-library'), url: url('logging-library/settings/runtime')},
	        secondary: {label: 'File Logs'|t('logging-library'), url: url('logging-library/settings/files')},
	    },
	    tasks: [
	        {
	            done: true,
	            heading: 'Runtime Logs'|t('logging-library'),
	            complete: {
	                status: 'info',
	                heading: runtime.enabled ? 'Enabled'|t('lindemannrock-base') : 'Disabled'|t('lindemannrock-base'),
	                body: settings.edgeEnvironmentDetected
	                    ? 'Consider Runtime Logs for recent diagnostics on ephemeral hosting. Confirm shared storage before relying on logs from multiple instances.'|t('logging-library')
	                    : 'Recent runtime logs use a bounded diagnostic store and are not complete log history.'|t('logging-library'),
	            },
	        },
	    ],
	}
%}

{% block content %}
	{% embed 'lindemannrock-base/_layouts/cp-plugin-setup' with {setupConfig: setupConfig, settings: settings} only %}
	{% block additionalContent %}
		<h2>{{ 'File Logs'|t('logging-library') }}</h2>
		{% include 'logging-library/_components/file-availability' with {settings: settings} only %}
		{% include 'logging-library/_components/runtime-storage' with {settings: settings} only %}
	{% endblock %}
	{% endembed %}
{% endblock %}
